# production environment. Committed with PLACEHOLDER values only — real secrets
# must be supplied via real environment variables (they override this file).
DJANGO_ENV=production

# Django
SECRET_KEY=production-placeholder-secret-key-change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,galactic-auction.example.com

# PostgreSQL — separate database per environment
POSTGRES_DB=galactic_auction_production
POSTGRES_USER=galactic_auction
POSTGRES_PASSWORD=production-placeholder-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (channel layer + cache)
REDIS_HOST=localhost
REDIS_PORT=6379
