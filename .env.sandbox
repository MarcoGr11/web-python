# sandbox environment. Committed with PLACEHOLDER values only — real secrets
# must be supplied via real environment variables (they override this file).
DJANGO_ENV=sandbox

# Django
SECRET_KEY=sandbox-placeholder-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — separate database per environment
POSTGRES_DB=galactic_auction_sandbox
POSTGRES_USER=galactic_auction
POSTGRES_PASSWORD=sandbox-placeholder-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (channel layer + cache)
REDIS_HOST=localhost
REDIS_PORT=6379
